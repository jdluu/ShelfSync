{
  "name": "shelfsync",
  "private": true,
  "version": "0.0.2",
  "packageManager": "pnpm@10.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:android": "pnpm secrets:fetch && tauri android build --apk",
    "build:android:aab": "pnpm secrets:fetch && tauri android build --aab",
    "android": "tauri android dev",
    "secrets:sync": "node scripts/sync-secrets.js",
    "secrets:fetch": "node scripts/sync-secrets.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test:e2e": "run-p --race test:e2e:dev test:e2e:run",
    "test:e2e:dev": "cross-env WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS=\"--remote-debugging-port=1422\" tauri dev",
    "test:e2e:run": "wait-on tcp:1422 -t 60000 && playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "~2.7.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-store": "~2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "clsx": "^2.1.1",
    "fast-average-color": "^9.6.0",
    "lucide-react": "^0.577.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-qr-code": "^2.0.18",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "daisyui": "^5.5.19",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "wait-on": "^9.5.1"
  }
}
