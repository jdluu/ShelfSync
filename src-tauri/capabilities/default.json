{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:read-all",
    "fs:write-all",
    "store:default",
    "dialog:default",
    "notification:default",
    "updater:default",
    "core:tray:default",
    "process:default",
    {
      "identifier": "fs:scope",
      "allow": ["$DOCUMENT/**/*", "$APPDATA/**/*"]
    }
  ]
}
