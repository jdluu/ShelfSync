{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "store:default",
    "dialog:default",
    "notification:default",
    "http:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "core:tray:default"
  ]
}
