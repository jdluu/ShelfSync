{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShelfSync",
  "version": "1.0.2",
  "identifier": "com.jdluu.shelfsync",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "title": "shelfsync",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http: https: data: blob:; connect-src 'self' http: https: ws: wss:; font-src 'self' data:"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/jdluu/ShelfSync/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1RTJBQTlEREZGQ0ExQjUKUldTMW9memZuYXJpNWJzUEhMZWV2NUhYYkpIMTJNQUhRZXA5ZGt3a3lVUWhVMkdQdklxQkJ5VjcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
